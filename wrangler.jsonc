{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homework",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "bloxbound.info", "custom_domain": true },
    { "pattern": "www.bloxbound.info", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
